# ─── Gemini / Model ────────────────────────────────────────────────────────
# Get your free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Model options: gemini-2.0-flash (fast) | gemini-1.5-pro (quality) | gemini-2.0-pro (latest)
GEMINI_MODEL=gemini-2.0-flash

# (Optional) For local FastAPI fallback with Ollama
OLLAMA_BASE_URL=http://ollama:11434

# ─── Auth ──────────────────────────────────────────────────────────────────
# Leave empty to disable API key auth (dev only).
# Set a strong random string in production: openssl rand -hex 32
API_SECRET_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Rate limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_S=60

# ─── System prompt ─────────────────────────────────────────────────────────
SYSTEM_PROMPT=You are a helpful Scrum and Agile assistant embedded in a team management app. Answer questions about Scrum ceremonies, sprint planning, velocity, retrospectives, and team dynamics concisely and clearly.
